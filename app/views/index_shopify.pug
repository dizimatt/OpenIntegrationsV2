html
  head
    title= title
  body
    h1= 'Welcome to Open Integrations Shopify App - shop: ' + shopurl
    table
      tr 
        th(style="border-bottom: 2px solid red;") Shopify
      tr
        td
          a(id="a-shopify-products" href='#') products
          br
          a(id="a-shopify-reindex-products" href='#') re-index products
          br
          a(id="a-shopify-indexed-products" href='#') indexed products
    br
    h3 Ask AI a question:
    form(id="form-openai" action="#") 
      textarea(id="textarea-openai-message", cols=40, rows=5)
      br
      input(id="btn-openai-send" type="button", value="Send")
      br
      textarea(id="textarea-openai-response", cols=40, rows=5)
      br
    br
    h2 output console
    hr

div(id="jquerydiv")

script(src="https://code.jquery.com/jquery-3.5.1.min.js")
script.

  var ws = null;

  $( document ).ready(function() {
    $("#a-shopify-products").click( function(e) {
      fetchShopifyProducts("#{shopurl}");
    });
    $("#a-shopify-indexed-products").click( function(e) {
      fetchShopifyIndexedProducts("#{shopurl}");
    });
    $("#a-shopify-reindex-products").click( function(e) {
      reindexShopifyProducts("#{shopurl}");
    });
    $("#btn-openai-send").click( function(e) {
      e.preventDefault();
      const openai_message = $("#textarea-openai-message").val();
      sendMessageWS(e);
      //openAISendMessage(openai_message);
    });
  });

  function fetchShopifyProducts(shopurl){
    console.log("fetchShopifyProducts");
    $.get( "/api/shopify/products?shop="+shopurl, function( data ) {
      $( "#jquerydiv" ).html("<H2>Shopify Products</H2>");
      data.products.forEach(product => {
        $( "#jquerydiv" ).append("<p>title:" + product.node.title + "</p>");
      });
    });
  };

  function reindexShopifyProducts(shopurl){
    console.log("reindexShopifyProducts");
    $.get( "/api/shopify/products/index?shop="+shopurl, function( data ) {
      $( "#jquerydiv" ).html("<H2>ReIndexed Shopify Products</H2>");
    });
  };
  function fetchShopifyIndexedProducts(shopurl){
    console.log("fetchShopifyIndexedProducts");
    $.get( "/api/products?shop="+shopurl, function( data ) {
      $( "#jquerydiv" ).html("<H2>Shopify Indexed Products</H2>");
      data.products.forEach(product => {
        $( "#jquerydiv" ).append("<p>title:" + product.title + "</p>");
      });
    });
  };

  function sendMessageWS(e) {
      console.log("called sendMessageWS");
      ws = new WebSocket("ws://localhost/api/openai/send-message-ws");
      e.preventDefault();
      var question = $('#textarea-openai-message').val(); 
      var url = "/send-message-ws";
      var data = {
          question: question
      };
      var dataType = "json";

      ws.addEventListener('message', function (event) {
          onMessageFromServer(event);
      });

      ws.onopen = function() {
          console.log('websocket open!');
          ws.send(JSON.stringify(data));
      };

  };
  function onMessageFromServer(e) {
      e.preventDefault();
      if (e.data == "<aitextdone />") {
          console.log('closing websocket!');
          ws.close();
      } else {
          $("#textarea-openai-response").val( $("#textarea-openai-response").val() +e.data);
      }
  };
