<h1>Please Ask Our Information Assistant about our products</h1>
 <a id="a-toggle-chatgpt" href="#">view the assistant</a><br/>
<div id="div-chatgpt-container" style="display:none;">
  <table id="table-openai">
    <tr>
      <th>
        <h3>Ask ChatGPT a question</h3>
      </th>
      <th>
        <h3>ChatGPT Response</h3>
      </th>
    </tr>
    <tr>
      <td>
        <form id="form-openai" action="#">
          <textarea id="textarea-openai-message" cols=40 rows=5></textarea>
          <br />
          <input id="btn-openai-send" type="button" value="Send" />
        </form>
      </td>
      <td>
        <textarea id="textarea-openai-response" cols=40, rows=5></textarea>
      </td>
    </tr>
  </table>

</div>
<!-- script defer src="https://code.jquery.com/jquery-3.5.1.min.js"></script -->
<script src="{{ 'jquery-3.7.1.min.js' | asset_url }}" defer="defer"></script>
<script>
  var ws = null;
  document.addEventListener('DOMContentLoaded', function() {
    $("#btn-openai-send").click( function(e) {
      e.preventDefault();
      sendMessageWS(e);
    });
    $("#a-toggle-chatgpt").click( function(e) {
      $("#div-chatgpt-container").show();
    });
  });    


  function sendMessageWS(e) {
//      const shop_url = window.Shopify.shop;
      const url = 'ws://a8bc-129-126-14-65.ngrok-free.app/api/openai/send-message-ws';
      ws = new WebSocket(url);
      e.preventDefault();
      var question = $('#textarea-openai-message').val(); 
      var data = {
          question: question
      };
      var dataType = "json";

      ws.addEventListener('message', function (event) {
          onMessageFromServer(event);
      });

      ws.onopen = function() {
          ws.send(JSON.stringify(data));
      };

  };
  function onMessageFromServer(e) {
      e.preventDefault();
      if (e.data == "<aitextdone />") {
          ws.close();
      } else {
          $("#textarea-openai-response").val( $("#textarea-openai-response").val() +e.data);
      }
  };

</script>